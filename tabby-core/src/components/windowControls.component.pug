//- macOS-style traffic lights: close, minimize, zoom
button.traffic-light.close(
    (click)='closeWindow()',
    title='Close',
)
    svg(version='1.1', width='8', height='8', viewBox='0 0 8 8')
        path(d='M 1.2,1.2 6.8,6.8 M 6.8,1.2 1.2,6.8', stroke='currentColor', stroke-width='1.1', fill='none', stroke-linecap='round')

button.traffic-light.minimize(
    (click)='hostWindow.minimize()',
    title='Minimize',
)
    svg(version='1.1', width='8', height='8', viewBox='0 0 8 8')
        path(d='M 1.2,4 6.8,4', stroke='currentColor', stroke-width='1.1', fill='none', stroke-linecap='round')

button.traffic-light.maximize(
    (click)='hostWindow.toggleMaximize()',
    title='Maximize',
)
    svg(version='1.1', width='8', height='8', viewBox='0 0 8 8')
        path(d='M 1.5,6.5 1.5,4.2 3.8,6.5 Z M 6.5,1.5 6.5,3.8 4.2,1.5 Z', fill='currentColor')
